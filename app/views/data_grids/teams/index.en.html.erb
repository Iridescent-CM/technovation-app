<% provide :title, "Teams" %>

<% if current_scope == "admin" %>
  <p style="margin-bottom: 16px;">
    <%= link_to "Set Semifinalists from CSV", "#",
      data: { opens_modal: "set_semifinalists_csv" },
      class: "button secondary small" %>

    <%= link_to "View semifinalist snippet",
      admin_semifinalist_snippet_path(format: :text),
      class: "button secondary small",
      target: "_blank",
      rel: "noopener" %>
  </p>
<% end %>

<%= render "datagrid/datagrid",
  grid: @teams_grid,
  form_url: send("#{current_scope}_teams_path"),
  model_name: "team",
  scope: current_scope.to_sym
%>

<% if current_scope == "admin" %>
  <%= render "admin/teams/set_semifinalists_modal" %>
<% end %>
